rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Admins collection — only authenticated users can read their own doc
    match /admins/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false; // Only writable from Firebase Console
    }

    // Products — anyone can read, only admins can write
    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Orders — anyone can create, only admins can read/update
    match /orders/{orderId} {
      allow create: if true;
      allow read, update: if request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Quotes — anyone can create, only admins can read/update
    match /quotes/{quoteId} {
      allow create: if true;
      allow read, update: if request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Messages — anyone can create, only admins can read/update
    match /messages/{messageId} {
      allow create: if true;
      allow read, update: if request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Users collection
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
